<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.marksisson.sphinx</string>

  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/sphinx</string>
    <string>--config</string>
    <string>/Users/USERNAME/Library/Application Support/sphinx/config.yaml</string>
    <string>tomb</string>
    <string>protect</string>
    <string>production</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/sphinx.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/sphinx.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
